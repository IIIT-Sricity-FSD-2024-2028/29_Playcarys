  "info": {
    "title": "PlayCarys OMGMP API",
    "description": "The Online Multiplayer Game Management Platform Backend API",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "role": {
        "type": "apiKey",
        "in": "header",
        "name": "role"
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "The email address of the user",
            "example": "dragon@example.com"
          },
          "password": {
            "type": "string",
            "description": "The password data",
            "example": "yourSecurePassw0rd!"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "user_name": {
            "type": "string",
            "description": "Desired username",
            "example": "NewPlayer99"
          },
          "email": {
            "type": "string",
            "description": "User contact email",
            "example": "hello@example.com"
          },
          "password": {
            "type": "string",
            "description": "Strong password",
            "example": "Testings123!"
          },
          "role_id": {
            "type": "number",
            "description": "Identifier mapping to internal DB roles (default: 4 = Player, 5 = Publisher)",
            "example": 4
          }
        },
        "required": [
          "user_name",
          "email",
          "password"
        ]
      },
      "CreateUserDto": {
        "type": "object",
        "properties": {}
      },
      "UpdateUserDto": {
        "type": "object",
        "properties": {}
      },
      "UpdateUserStatusDto": {
        "type": "object",
        "properties": {}
      },
      "AssignRoleDto": {
        "type": "object",
        "properties": {}
      },
      "UpdatePlayerProfileDto": {
        "type": "object",
        "properties": {}
      },
      "CreateGameDto": {
        "type": "object",
        "properties": {
          "game_name": {
            "type": "string",
            "description": "The display name of the game",
            "example": "Cyberpunk Quest"
          },
          "game_type": {
            "type": "string",
            "description": "Genre of the game",
            "example": "RPG"
          },
          "desc": {
            "type": "string",
            "description": "Detailed description of gameplay",
            "example": "Explore a neon-lit city..."
          },
          "players": {
            "type": "string",
            "description": "Player count boundaries",
            "example": "1-4"
          },
          "img": {
            "type": "string",
            "description": "Identifier of the image asset",
            "example": "cyberpunk_quest"
          },
          "game_publisher": {
            "type": "number",
            "description": "Internal ID of the Publisher User",
            "example": 5
          }
        },
        "required": [
          "game_name",
          "game_type",
          "desc",
          "players",
          "game_publisher"
        ]
      },
      "UpdateGameRequestDto": {
        "type": "object",
        "properties": {}
      },
      "SetGameStateRequestDto": {
        "type": "object",
        "properties": {}
      },
      "ApproveGameDto": {
        "type": "object",
        "properties": {
          "game_approval_status": {
            "type": "string",
            "description": "Next approval status",
            "example": "approved",
            "enum": [
              "approved",
              "rejected"
            ]
          },
          "note": {
            "type": "string",
            "description": "Optional admin note",
            "example": "Everything looks good."
          }
        },
        "required": [
          "game_approval_status"
        ]
      },
      "CreateTournamentDto": {
        "type": "object",
        "properties": {}
      },
      "RegisterPlayerDto": {
        "type": "object",
        "properties": {}
      },
      "UpdateTournamentDto": {
        "type": "object",
        "properties": {}
      },
      "CreateSessionDto": {
        "type": "object",
        "properties": {}
      },
      "QuickPlayDto": {
        "type": "object",
        "properties": {}
      },
      "JoinSessionDto": {
        "type": "object",
        "properties": {}
      },
      "EndSessionRequestDto": {
        "type": "object",
        "properties": {}
      },
      "CreateReportDto": {
        "type": "object",
        "properties": {}
      },
      "UpdateReportStatusDto": {
        "type": "object",
        "properties": {}
      },
      "CreateModeratorActionDto": {
        "type": "object",
        "properties": {}
      },
      "HandleViolationDto": {
        "type": "object",
        "properties": {}
      },
      "LiftBanDto": {
        "type": "object",
        "properties": {}
      },
      "CreateNotificationDto": {
        "type": "object",
        "properties": {}
      },
      "ReplyDto": {
        "type": "object",
        "properties": {}
      },
      "MarkReadDto": {
        "type": "object",
        "properties": {}
      },
      "NotificationAudienceDto": {
        "type": "object",
        "properties": {}
      }
    }
